# ============================================================================
# REQUIRED VARIABLES
# ============================================================================

# Database URL (PostgreSQL - Neon or local)
# Format: postgresql://user:password@host:5432/dbname
# Get from: https://neon.tech (free tier available)
# Example: postgresql://user:abc123@ep-xxx.neon.tech/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/anti_penyimpangan

# Better Auth Secret (Generate with: openssl rand -base64 32)
# IMPORTANT: Keep this secret! Don't share it!
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# Better Auth URL (where your app is hosted)
# Development: http://localhost:3003 (port 3003 by default)
# Production: https://anti-penyimpangan.lombok26.biz.id
BETTER_AUTH_URL=http://localhost:3003

# Application Public URL (for API calls from frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3003

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# Vercel Blob (for file uploads - optional)
# Get from: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here

# Node Environment
# development | production
NODE_ENV=development

# ============================================================================
# NOTES & INSTRUCTIONS
# ============================================================================
# 
# PORT CONFIGURATION:
# - Default port: 3003 (hardcoded in package.json scripts)
# - Dev command: pnpm dev -p 3003
# - Start command: pnpm start -p 3003
# - For localhost:3000 development, use: pnpm dev:local
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Update DATABASE_URL with your PostgreSQL connection string
# 3. Generate BETTER_AUTH_SECRET: openssl rand -base64 32
# 4. Update BETTER_AUTH_URL to match your app URL
# 5. Run: pnpm install && pnpm build && pnpm start
#
# FOR PRODUCTION ON TERMUX:
# 1. Use .env.production file (different from .env.local)
# 2. Set BETTER_AUTH_URL=https://anti-penyimpangan.lombok26.biz.id
# 3. Set NODE_ENV=production
# 4. Ensure database is accessible from Termux
#
# FOR DEVELOPMENT:
# 1. Use localhost:3003 for BETTER_AUTH_URL
# 2. Set NODE_ENV=development
# 3. Run: pnpm dev
