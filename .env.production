# Production Environment Variables
# Untuk Termux Self-Hosted Server

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL - Neon)
# ============================================================================
# Format: postgresql://user:password@host/dbname
# Dapatkan dari: https://neon.tech (free tier available)
# Example: postgresql://user:abc123@ep-xxx.neon.tech/dbname
DATABASE_URL=postgresql://user:password@your-host/dbname

# ============================================================================
# BETTER AUTH CONFIGURATION
# ============================================================================
# Generate secret: openssl rand -base64 32
# Jangan share secret ini!
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Application URL (dengan domain custom)
BETTER_AUTH_URL=https://anti-penyimpangan.lombok26.biz.id

# Node Environment
NODE_ENV=production

# ============================================================================
# NEXT.JS PUBLIC VARIABLES (dapat diakses di frontend)
# ============================================================================
# URL aplikasi (untuk API calls dari frontend)
NEXT_PUBLIC_APP_URL=https://anti-penyimpangan.lombok26.biz.id

# ============================================================================
# VERCEL BLOB (File Upload Storage)
# ============================================================================
# Token untuk upload file (optional, jika tidak ada file upload disabled)
# Dapatkan dari: https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================================================
# PERFORMANCE
# ============================================================================
# Cache strategy
REVALIDATE_TIME=60

# ============================================================================
# SECURITY
# ============================================================================
# CORS origins (untuk API access)
ALLOWED_ORIGINS=https://anti-penyimpangan.lombok26.biz.id,https://www.anti-penyimpangan.lombok26.biz.id

# ============================================================================
# NOTES UNTUK TERMUX
# ============================================================================
# 1. Port hardcoded di package.json scripts (3003)
# 2. BETTER_AUTH_URL harus match domain + schema (https)
# 3. Untuk development di Termux, copy ke .env.local dan update localhost
# 4. DATABASE_URL penting! Tanpa ini app tidak jalan
